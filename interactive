worker_select_frontend() {
  [[ -z $GA_VIDEO_DATA ]] && GA_VIDEO_DATA=/opt/galauncher/videodata.conf
  local curr_video="$(get_config_value "$GA_CONF" video.backend)"
  curr_video=${curr_video:-X}
  inform "Building the offline frontends list for $curr_video..."
  
  fe_list=()
  declare -A fe_list_no_index
  idx=1
  fe_available=0

  for fe in $(grep -E -o "^frontend\.[[:alnum:]-]*\." "$GA_VIDEO_DATA" | sort | uniq | cut -d '.' -f 2) ; do
    [[ "$fe" == "pegasus-frontend" ]] && continue

    if pacman -Qi "$fe" &>/dev/null && check_frontend_video_backend_available "$curr_video" "$fe" ; then
      fe_available=1
      fe_list+=("$idx" "$fe")
      fe_list_no_index[$idx]="$fe"
      idx=$((idx + 1))
    fi
    if pacman -Qi "$fe"-git &>/dev/null && check_frontend_video_backend_available "$curr_video" "$fe" ; then
      fe_available=1
      fe_list+=("$idx" "$fe"-git)
      fe_list_no_index[$idx]="${fe}-git"
      idx=$((idx + 1))
    fi
  done

  if [[ $fe_available == 0 ]] ; then
    inform "Couldn't find any installed emulator compatible with $curr_video" ; sleep 2
    return 1
  fi

  fe_list+=("$idx" "lxde")
  fe_list_no_index[$idx]="lxde"

  ask_option 1 "Select a frontend (Offline Mode)" '' required "${fe_list[@]}"
  ret_code=$?
  selected_fe="${fe_list_no_index[${ANSWER_OPTION}]}"
  
  if [[ -z "$selected_fe" && $ret_code == 0 ]] ; then
    notify "Couldn't set your FE to $selected_fe"
    return 1
  elif [[ -z "$selected_fe" && $ret_code == 1 ]] ; then
    return 1
  fi

  if ! set_config_value "$GA_CONF" frontend "$selected_fe" ; then
    notify "Couldn't set the frontend, you may not reach it"
    return 1
  fi
  
  inform "Successfully set your frontend to $selected_fe" ; sleep 2
  log_info "Switched FE to $selected_fe on $curr_video"
  return 0
}


