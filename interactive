worker_lpt_keycoder_install() {
  clear
  echo "Preparing environment for LPT Keycoder installation..."
  sleep 1
  
  # --- CONFLICT RESOLUTION BEFORE INSTALL ---
  # Remove OpenPPJOY auto-load to prevent boot conflicts
  sudo rm -f /etc/modules-load.d/openppjoy.conf 2>/dev/null
  # Unload conflicting kernel-space modules
  sudo rmmod gamecon 2>/dev/null
  sudo rmmod openppjoy 2>/dev/null
  sudo rmmod parport_pc 2>/dev/null
  # ------------------------------------------
  
  sudo /opt/gatools/lpt_keycoder/setup_lpt.sh
  
  echo -e "\nPress [ENTER] to return to the menu..."
  read
  return 0
}

worker_lpt_keycoder_enable() {
  inform "Starting and enabling LPT Keycoder service..."
  
  # --- CONFLICT RESOLUTION ---
  # Remove OpenPPJOY auto-load
  sudo rm -f /etc/modules-load.d/openppjoy.conf 2>/dev/null
  
  # Unload conflicting kernel-space modules
  sudo rmmod gamecon 2>/dev/null
  sudo rmmod openppjoy 2>/dev/null
  sudo rmmod parport_pc 2>/dev/null
  
  # Ensure user-space modules are loaded for the Keycoder
  sudo modprobe lp 2>/dev/null
  sudo modprobe ppdev 2>/dev/null
  # ---------------------------

  sudo systemctl enable lpt_keycoder.service 2>/dev/null
  sudo systemctl start lpt_keycoder.service 2>/dev/null
  
  notify "LPT Keycoder service has been successfully enabled!\n\nHardware conflict resolved. OpenPPJOY modules unloaded."
  return 0
}

worker_lpt_keycoder_disable() {
