worker_openppjoy_enable() {
  inform "Enabling Gamecon/OpenPPJOY modules for SNES/JAMMA..."
  
  # --- CONFLICT RESOLUTION ---
  # 1. Stop and disable LPT Keycoder service to free up the Parallel Port
  if systemctl is-active --quiet lpt_keycoder.service 2>/dev/null || systemctl is-enabled --quiet lpt_keycoder.service 2>/dev/null; then
      sudo systemctl stop lpt_keycoder.service 2>/dev/null
      sudo systemctl disable lpt_keycoder.service 2>/dev/null
  fi
  
  # 2. Unload the conflicting user-space parallel port modules
  sudo rmmod lp 2>/dev/null
  sudo rmmod ppdev 2>/dev/null
  # ---------------------------

  # 3. Create the modprobe options file WITH BLACKLIST
  cat <<EOF | sudo tee /etc/modprobe.d/openppjoy-options.conf > /dev/null
blacklist lp
blacklist ppdev
options openppjoy map=0,2,3
options gamecon map=0,1,1,1,1
EOF

  # 4. Create the auto-load file
  cat <<EOF | sudo tee /etc/modules-load.d/openppjoy.conf > /dev/null
parport_pc
#openppjoy
gamecon
EOF
  
  # 5. Clean up the kernel space for a fresh start
  sudo rmmod gamecon 2>/dev/null
  sudo rmmod openppjoy 2>/dev/null
  sudo rmmod parport_pc 2>/dev/null
  
  # 6. Load the correct modules for SNES controllers
  sudo modprobe parport_pc 2>/dev/null
  sudo modprobe gamecon 2>/dev/null
  
  # Added the explicit warning about LPT Keycoder being disabled
  notify "Gamecon/OpenPPJOY enabled successfully!\n\nHardware conflict resolved: LPT Keycoder was disabled.\n4x SNES controllers are now active."
  return 0
}

worker_openppjoy_disable() {
  inform "Disabling Gamecon/OpenPPJOY modules..."
  
  # Remove configurations (including the blacklist)
  sudo rm -f /etc/modules-load.d/openppjoy.conf
  sudo rm -f /etc/modprobe.d/openppjoy-options.conf
  
  # Unload modules from the running kernel
  sudo rmmod gamecon 2>/dev/null
  sudo rmmod openppjoy 2>/dev/null
  
  notify "Modules have been successfully disabled."
  return 0
}

