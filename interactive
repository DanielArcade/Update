# Ensures the good integrity of the installation
sanity_checks() {
  # Check that the configured frontend is installed
  FE=$(get_config_value "$GA_CONF" frontend)
  # lxde is a group, not a package
  if [[ -n $FE && $FE != lxde ]] ; then
    if ! $(pacman -Q "$FE" &>/dev/null || pacman -Q "$FE"-git &>/dev/null); then
      notify "Frontend error: $FE is not installed"
      log_warn "$FE is configured as the default FE but is not installed"
    fi
  fi

  # $GA_CONF and CONFIG_FILE should be the same by now
  if [[ ! -L "$_HOME"/.config/ga.conf ]] ; then
    log_info "Making $_HOME/.config/ga.conf a symlink"
    cp "$_HOME"/.config/ga.conf "$GA_CONF"
    rm "$_HOME"/.config/ga.conf
    ln -s "$GA_CONF" "$_HOME"/.config/ga.conf
  fi

  if [[ ! -e "$_HOME"/1 ]] ; then
    if ! grep -q "/opt/galauncher/startfe-X.sh" "$_HOME"/.xinitrc || ! grep -q "/opt/galauncher/startfe.sh" "$_HOME"/.bash_profile ; then
      cp "$_HOME"/.xinitrc "$_HOME"/.xinitrc.backup
      cp "$_HOME"/.bash_profile "$_HOME"/.bash_profile.backup
      /opt/gasetup/gasetup.sh -p interactive -n groovyarcade
      notify "your .xinitrc and .bash_profile have been backuped with the .backup extension. New ones have been installed"
    fi
  fi

  if [[ ! -e "$_HOME"/.drirc ]] ; then
    log_info "Creating $_HOME/.drirc"
    cat <<EOF | su - ${_USER} -c "tee '$_HOME/.drirc'"
<device>
    <application name="Default">
        <option name="mesa_glthread" value="false" />
    </application>
</device>
EOF
  fi

  set_ra_config_value desktop_menu_enable "false"

  if [[ $(lsblk --include 7 | grep "archiso" | wc -l) == 1 ]] ; then
    true
  else
    space_left="$(df --output=pcent / | tail -1 | grep -oE '[0-9]+')"
    if [[ $space_left -gt 90 ]] ; then
      notify "Your main drive has less than 10% free space left"
    fi
  fi
}
