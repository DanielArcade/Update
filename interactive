      *) notify "Bad option $ANSWER_OPTION given" ;;
    esac
  done

  return 0
}


worker_select_install() {
  if [[ "iso net" != *"$1"* ]] ; then
    inform "Wrong installation method" && sleep 2
    return
  fi

  inform "Installing GroovyArcade..."

  if [[ "$1" == "iso" ]] ; then
    execute worker pre_install || return
    execute worker select_iso_install
  elif [[ "$1" == "net" ]] ; then
    execute worker select_net_install
  fi

  if [[ $? != 0 ]] ; then
    inform "Installation aborted, try again" | sleep 2
    killall gpg-agent ; sleep 1 ; umount /dev/sda1 ; umount /dev/sda3
    return 1
  fi

  execute worker post_install
}


worker_pre_install() {
  if [ ! -d "/run/archiso/" ]; then
    notify "You aren't booting from a LiveCD so can't install."
    return 1
  fi

  if [ -d "/groovyarcade/etc" ]; then
    notify "You have already installed, cannot do it twice!!!"
    return 1
  fi
  DOING_INSTALL=1
  lsblk -o MOUNTPOINT | grep -q "^/media" && sudo umount /media/* >/dev/tty12 2>&1
  SETUP=1

  if ! grep -qE "monitor=.+" "$GA_CONF" ; then
    ask_yesno "Do you want to setup Video?" || SETUP=0
    if [ "$SETUP" = "1" ]; then
      worker_video_menu
    fi
  fi

  SETUP=1

  if [[ ! -d /run/archiso/bootmnt/ ]] ; then
    mkdir -p /run/archiso/bootmnt
    isolabel="$(blkid | grep -oE 'LABEL="GA_20[0-9]{2}[_.][0-9]{2}' | cut -d '"' -f2)"
    mount -L "$isolabel" /run/archiso/bootmnt/ -o ro
  fi

  tmp_val="$(grep "KERNEL_DEFAULT_CMDLINE=" /run/archiso/bootmnt/boot/syslinux/syslinux.cfg)"
  default_cmdline=${tmp_val#*KERNEL_DEFAULT_CMDLINE=}
  if [[ -f "$GA_CONF" ]] && grep -q "^kernel_video_cmdline=" "$GA_CONF"; then
    tmp_val="$(grep "^kernel_video_cmdline=" "$GA_CONF")"
    export kernel_video_params="${tmp_val#*kernel_video_cmdline=}"
  fi
  
  RAN_AUTOPART=no
  execute worker select_and_partition_disk || return 1
  RAN_AUTOPART=yes
}


worker_post_install() {
  cp /etc/switchres.ini /groovyarcade/etc
  cp /home/arcade/shared/configs/mame/mame.ini /groovyarcade/home/arcade/shared/configs/mame/
  cp /home/arcade/shared/configs/ga.conf /groovyarcade/home/arcade/shared/configs/ga.conf
  mkdir -p /groovyarcade/{dev,proc,sys,tmp,run,mnt,media}
  rm -f /groovyarcade/home/arcade/1
  rm -Rf /groovyarcade/home/arcade/lost+found /groovyarcade/home/roms/lost+found
  cp /etc/pacman.d/groovy-ux-repo.conf /groovyarcade/etc/pacman.d/groovy-ux-repo.conf
  install -Dm644 -o arcade -g arcade /home/arcade/.config/systemd/user/udiskie.service /groovyarcade/home/arcade/.config/systemd/user/udiskie.service
  cp -vrp /home/arcade/.config/systemd/user/default.target.wants /groovyarcade/home/arcade/.config/systemd/user/

  cat >/groovyarcade/home/arcade/.bash_profile <<'EOF'
#!/bin/bash

if [[ -f ~/.bashrc ]] ; then
    . ~/.bashrc
fi

if [[ $(tty) == /dev/tty1 ]] ; then
    sudo setterm --powerdown 0 --blank 0
    /opt/galauncher/startfe.sh
    sudo gasetup
    /opt/gasetup/login.sh
fi
EOF
  chown -R arcade:arcade /groovyarcade/home/arcade

  genfstab -U /groovyarcade > /groovyarcade/etc/fstab

  alsactl store
  cp /var/lib/alsa/asound.state /groovyarcade/var/lib/alsa/

  inform "Final configuration steps"
  arch-chroot /groovyarcade /bin/bash --login <<CHROOTED
    cd /root/
    systemd-machine-id-setup
    locale-gen -a
    [[ ! -d $(pacman-conf --config="/etc/pacman.conf" gpgdir) ]] && (sudo pacman-key --init && sudo pacman-key --populate archlinux)
    mv /etc/mkinitcpio-installed.conf /etc/mkinitcpio.conf

    [[ -f /etc/systemd/journald.conf.d/volatile-storage.conf ]] && rm /etc/systemd/journald.conf.d/volatile-storage.conf
    mkdir -p /var/log/journal
    systemd-tmpfiles --create --prefix /var/log/journal

    systemctl disable choose-mirror.service livecd-alsa-unmuter.service reflector.service
    systemctl enable reflector.timer
    rm -r /etc/systemd/system/{choose-mirror.service,etc-pacman.d-gnupg.mount}

    plymouth-set-default-theme -R groovy
    rm /etc/mkinitcpio-dvd.conf
    rm -r /etc/initcpio
    rm /usr/lib/systemd/system/multi-user.target.wants/plymouth-quit*
CHROOTED

  arch-chroot -u arcade /groovyarcade /bin/bash --login <<CHROOTED
    mkdir -p /home/arcade/.config/systemd/user/default.target.wants
    ln -s /home/arcade/.config/systemd/user/udiskie.service /home/arcade/.config/systemd/user/default.target.wants/
CHROOTED

  install_LIMINE
  configure_boot_loader LIMINE

  DIR_PENDRIVE="/run/archiso/bootmnt/shared"
  DIR_DESTINATION="/groovyarcade/home/arcade/shared"
  
  if [ -d "$DIR_PENDRIVE" ]; then
      if ask_yesno "A 'shared' folder was found on your USB drive.\nDo you want to copy its contents to your hard drive now?\n(This will overwrite existing files)"; then
          inform "Preparing to copy shared files..."
          mkdir -p "$DIR_DESTINATION"
          
          TOTAL_FILES=$(find "$DIR_PENDRIVE" -type f | wc -l)
          if [ "$TOTAL_FILES" -gt 0 ]; then
              (
                  COUNT=0
                  find "$DIR_PENDRIVE" -type f | while IFS= read -r FILE; do
                      REL_PATH="${FILE#$DIR_PENDRIVE/}"
                      mkdir -p "$DIR_DESTINATION/$(dirname "$REL_PATH")"
                      cp -f "$FILE" "$DIR_DESTINATION/$REL_PATH" 
                      COUNT=$((COUNT + 1))
                      PERCENT=$((COUNT * 100 / TOTAL_FILES))
                      echo "$PERCENT"
                  done
              ) | dialog --title "Copying Shared Files" --gauge "Copying files to /home/arcade/shared...\nPlease wait, this may take a while." 10 70
          else
              cp -rf "$DIR_PENDRIVE"/* "$DIR_DESTINATION/" 2>/dev/null
          fi
          
          arch-chroot /groovyarcade chown -R arcade:arcade /home/arcade/shared
          notify "Shared folder copy completed successfully!"
      fi
  fi

  # --- APPLY VIDEO PROFILES (CRT/LCD) ---
  # Read the chosen monitor from the LiveCD's active ga.conf ($GA_CONF)
  local current_monitor=$(get_config_value "$GA_CONF" monitor)
  [[ -z "$current_monitor" ]] && current_monitor="lcd"
  
  inform "Applying video profiles for $current_monitor..."

  local is_lcd=0
  if [[ "$current_monitor" == "lcd" || "$current_monitor" == "vesa"* ]]; then
      is_lcd=1
  fi

  # Templates are located in the LiveCD filesystem
  local template_dir="/opt/gasetup/core/configs"
  
  # Target files are located in the newly installed Hard Drive
  local target_dir="/groovyarcade/home/arcade/shared/configs"
  local profiles=()

  # Define which templates to use based on the selected monitor type
  if [[ $is_lcd == 1 ]]; then
      profiles=(
          "$template_dir/groovymame/mame_lcd.ini|$target_dir/mame/mame.ini|yes"
          "$template_dir/retroarch/retroarch_lcd.cfg|$target_dir/retroarch/retroarch.cfg|no"
          "$template_dir/flycast/emu_lcd.cfg|$target_dir/flycast/emu.cfg|no"
      )
  else
      profiles=(
          "$template_dir/groovymame/mame_crt.ini|$target_dir/mame/mame.ini|yes"
          "$template_dir/retroarch/retroarch_crt.cfg|$target_dir/retroarch/retroarch.cfg|no"
          "$template_dir/flycast/emu_crt.cfg|$target_dir/flycast/emu.cfg|no"
      )
  fi

  # Loop through the profiles and inject the configurations into the HDD files
  for prof in "${profiles[@]}"; do
      local profile="${prof%%|*}"
      local rest="${prof#*|}"
      local target="${rest%%|*}"
      local is_mame="${rest#*|}"

      # Skip if the source template or the target config file does not exist
      [[ ! -f "$profile" || ! -f "$target" ]] && continue

      while IFS= read -r line || [[ -n "$line" ]]; do
          [[ -z "$line" ]] && continue

          if [[ "$is_mame" == "yes" ]]; then
              local key=$(echo "$line" | awk '{print $1}')
              local val=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ *//')
              
              # Special override for MAME monitor variable if CRT is selected
              if [[ "$key" == "monitor" && "$is_lcd" == "0" ]]; then
                  val="$current_monitor"
              fi
              
              if grep -qE "^[[:space:]]*${key}[[:space:]]+" "$target" ; then
                  sed -i -E "s/^[[:space:]]*${key}[[:space:]]+.*/${key}                  ${val}/" "$target"
              else
                  echo "${key}                  ${val}" >> "$target"
              fi
          else
              local key=$(echo "$line" | cut -d '=' -f 1 | tr -d ' ')
              local val=$(echo "$line" | cut -d '=' -f 2- | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
              
              if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$target" ; then
                  sed -i -E "s/^[[:space:]]*${key}[[:space:]]*=.*/${key} = ${val}/" "$target"
              else
                  echo "${key} = ${val}" >> "$target"
              fi
          fi
      done < "$profile"
  done
  # --------------------------------------

  if ask_yesno "Installation almost finished.\nDo you want to create a Swap file on your hard drive now?\n(Recommended for systems with low RAM)"; then
      inform "Creating swap file... This may take a moment."
      if ! swapsize="$(decide_swap_size)" ; then
          log_warn "Failed to get swap size, force it to 4G"
          swapsize=4
      fi
      
      mkswap -U 0657FD6D-A4AB-43C4-84E5-0933C84B4F4F --size ${swapsize}G --file /groovyarcade/.swapfile
      notify "Swap file created successfully!"
  fi
  
  ask_yesno "Installation finished, Do you want to reboot? (remove CDROM afterwards)" || DOING_INSTALL=0 return 0

  worker_power_action reboot
  DOING_INSTALL=0
  return 0
}

worker_select_net_install() {
  if ! ping -c 1 -W 2 github.com &>/dev/null ; then
    notify "You don't seem connected to Internet. Aborting."
    return 1
  fi

  curl -s https://archlinux.org/mirrorlist/all/https/ | sed 's+^#\(Server =.*\)+\1+' | sudo tee /etc/pacman.d/mirrorlist &>/dev/null || return 1
  sudo pacman -Sy --noconfirm --needed archlinux-keyring || return 1

  execute worker pre_install || return 1

  inform "Probing fastest up-to-date servers..."
  reflector --latest 20 \
    --sort rate \
    --protocol https \
    --save /etc/pacman.d/mirrorlist

  pacstrap -P -K /groovyarcade base
  arch-chroot /groovyarcade groupadd --gid 1000 arcade
  arch-chroot /groovyarcade useradd --uid 1000 --gid 1000 arcade

  cp /etc/pacman.d/groovy-ux-repo.conf /groovyarcade/etc/pacman.d/groovy-ux-repo.conf

  curl -L https://gitlab.com/groovyarcade/os/-/raw/master/groovyarcade/packages.x86_64 | grep -v '^#' > /tmp/packages.x86_64
  if pacman -Qi gasetup 2>/dev/null | grep -E '^Name[[:space:]]+' | grep -q 'gasetup-git' ; then
    sed -i -e 's/gasetup/gasetup-git/' \
      -e 's/gatools/gatools-git/' \
      -e's/galauncher/galauncher-git/' /tmp/packages.x86_64
  fi
  pacstrap -K /groovyarcade - < /tmp/packages.x86_64
  if [[ $? != 0 ]] ; then
    inform "Couldn't install packages, aborting" ; sleep 2
    return 1
  fi

  curl -sL https://gitlab.com/groovyarcade/os/-/archive/master/os-master.tar.gz | tar xvzf - --no-overwrite-dir -C /groovyarcade --strip-components=3 os-master/groovyarcade/airootfs

  arch-chroot /groovyarcade chown -R arcade:arcade /home/arcade

  arch-chroot /groovyarcade /bin/bash -c 'curl -L "https://github.com/substring/os/raw/master/groovyarcade/airootfs/root/customize_airootfs.sh" | sed "s/set -e -u//" | bash'
}


worker_select_iso_install() {
  swapoff -a
  
  unsquashfs -q -f -d /groovyarcade -percentage /run/archiso/bootmnt/groovyarcade/x86_64/airootfs.sfs | dialog --gauge "Installing to HD" 10 50
  mkdir -p /groovyarcade/{dev,proc,sys,tmp,run,mnt,media}

  cp -va /run/archiso/bootmnt/groovyarcade/boot/$(uname -m)/vmlinuz* /groovyarcade/boot/
  cp -va /run/archiso/bootmnt/groovyarcade/boot/*-ucode.img /groovyarcade/boot/
}

worker_audio_menu() {
  local default=no
  AUDIO_SETUP=1
  while [ 0 = 0 ]; do
    ask_option $default "Audio Setup Menu" "Setup Audio" required \
      1 "Default Card" \
      2 "Change Volume" \
      3 "AlsaMixer" \
      4 "Audio Latency MAME" \
      5 "Return to Main" || return

    case $ANSWER_OPTION in
      "1") execute worker default_card && default=2 ;;
      "2") execute worker set_volume && default=3 ;;
      "3") execute worker alsamixer && default=4 ;;
      "4") execute worker audio_latency && default=5 ;;
      "5") return 0 ;;
      *) notify "Bad option $ANSWER_OPTION given" ;;
    esac
  done
  return 0
}

worker_alsamixer() {
  if ! alsa_card_num=$(get_config_value "$GA_CONF" alsa| cut -d ',' -f 1) ; then
    alsa_card_num=0
  fi
  alsamixer -c $alsa_card_num
  alsactl store $alsa_card_num
  return 0
}

worker_default_card() {
  declare -a audiodev
  while IFS='\n' read l ; do
    cardnum=$(echo $l | sed -E 's!card ([0-9]+):.*!\1!')
    cardname=$(echo $l | sed -E 's!.*\[(.*)\],.*!\1!')
    devnum=$(echo $l | sed -E 's!.*device ([0-9]+):.*!\1!')
    devname=$(echo $l | sed -E 's!.*\[(.*)\]$!\1!')
    audiodev+=("$cardnum,$devnum" "$cardname $devname")
  done < <(LANG=C aplay --list-devices | grep "^card")
  ask_option $default "Select Sound Card" "Choose a Sound Card." required "${audiodev[@]}" || return  1
  DEF=$ANSWER_OPTION
  card_num=$(echo $DEF |cut -d',' -f 1)
  dev_num=$(echo $DEF |cut -d',' -f 2)
  set_config_value "$GA_HOME"/.asoundrc defaults.pcm.card $card_num ' '
  set_config_value "$GA_HOME"/.asoundrc defaults.ctl.card $card_num ' '
  set_config_value "$GA_HOME"/.asoundrc defaults.pcm.device $dev_num ' '
  set_config_value "$GA_CONF" alsa "$DEF"
  return 0
}

worker_audio_latency() {
  PREV=$(get_mame_config_value 'audio_latency')
  ask_string "Audio latency MAME\nDefault 2.0 , Max 2.0 Min 0" "$PREV" || return 0
  LAT=${ANSWER_STRING// /}
  set_mame_config_value audio_latency "$LAT"
  return 0
}

worker_set_volume() {
  CURVOL=$(get_config_value "$GA_CONF" volume)
  ask_string "Audio Volume (0-100)" "$CURVOL" || return 1
  VOLUME=${ANSWER_STRING// /}

  audiodev=$(get_config_value "$GA_CONF" alsa| cut -d ',' -f 1)
  if [ "$audiodev" = "" ]; then
    audiodev=0
  fi
  amixer sset -c $audiodev PCM 200 unmute 2>&1 0>&1 >/dev/null
  amixer sset -c $audiodev Master ${VOLUME}% unmute 2>&1 0>&1 >/dev/null
  amixer sset -c $audiodev Front ${VOLUME}% unmute 2>&1 0>&1 >/dev/null
  alsactl store $audiodev

  set_config_value "$GA_CONF" volume "$VOLUME"
  AUDIO_SETUP=1

  return 0
}


worker_network_menu() {
  local default=no
  IFACES=$(ip link | grep BROADCAST | sed -e s/://g | awk '{printf("%s -\n", $2)}')

  while [ 0 = 0 ]; do
    ask_option $default "Network Setup Menu" "Setup Network" required \
      1 "WiFi setup (new)" \
      4 "Return to Main" || return

    case $ANSWER_OPTION in
      "1") execute worker configure_wifi ;;
      "2")
        ask_option $default "Setup Network Interface" "Choose an interface" required $IFACES "Cancel" "-" || return 1
        if [ "$ANSWER_OPTION" = "Cancel" ]; then
          execute worker network_menu
          return
        fi

        cat $CONFIG_FILE | sed -e 's/network=.*//g' | grep -v ^$ >${CONFIG_FILE_TMP}
        mv ${CONFIG_FILE_TMP} ${CONFIG_FILE}
        echo "network=$ANSWER_OPTION" >>$CONFIG_FILE
        IFACE=$ANSWER_OPTION
        sudo ifconfig $IFACE up
        WIRED=yes
        file=wired

        ask_yesno "Is $IFACE a Wired Device?" || WIRED=no
        if [ "${WIRED}" = "no" ]; then
          ask_option $default "Setup Network ESSID" "Choose an ESSID" required \
            1 "Manual ESSID" \
            2 "Search ESSID" || return

          if [ $ANSWER_OPTION = "1" ]; then
            PREVSS=$(grep ssid= $CONFIG_FILE | awk -F = '{print $2}')
            ask_string "Wireless SSID:" "$PREVSS" || return 1
            SSID=$ANSWER_STRING
          else
            sudo ifconfig $IFACE down up
            LIST=$(iwlist $IFACE scanning | grep -i ESSI | sed -e s/ESSID://g | sed -e s/'"'//g | sed 's/^\s*//' | sed -e "s/ /+/g" | awk '{printf("%s -\n", $1)}')

            if [ "$LIST" = "" ]; then
              inform "Wireless Not Found"
              sleep 2
              return 0
            fi

            ask_option $default "List Wireless ESSID" "Choose a Wireless" required $LIST || return 1
            SSID=$(echo $ANSWER_OPTION | sed -e "s/+/ /g")
          fi

          PREVKEY=$(grep psk= $CONFIG_FILE | awk -F = '{print $2}')
          ask_string "Wireless Key:" "$PREVKEY" || return 1
          KEY=${ANSWER_STRING// /}

          ask_option $default "Wireless Security" "Select your Wireless Security" required \
            1 "Open" \
            2 "Wep" \
            3 "Wpa" || return

          case $ANSWER_OPTION in
            "1") SECURI=none ;;
            "2") SECURI=wep ;;
            "3") SECURI=wpa ;;
          esac

          cat $CONFIG_FILE | sed -e 's/ssid=.*//g' | grep -v ^$ >${CONFIG_FILE_TMP}
          mv ${CONFIG_FILE_TMP} ${CONFIG_FILE}
          echo "ssid=$SSID" >>$CONFIG_FILE
          cat $CONFIG_FILE | sed -e 's/psk=.*//g' | grep -v ^$ >${CONFIG_FILE_TMP}
          mv ${CONFIG_FILE_TMP} ${CONFIG_FILE}
          echo "psk=$KEY" >>$CONFIG_FILE
          execute worker disable_wiimote
          file=wifi
        fi
        cat $CONFIG_FILE | sed -e 's/wireless=.*//g' | grep -v ^$ >${CONFIG_FILE_TMP}
        mv ${CONFIG_FILE_TMP} ${CONFIG_FILE}
        echo "wireless=$WIRED" >>$CONFIG_FILE

        DINAMIC=yes
        ask_yesno "Setup $IFACE with a dynamic IP?" || DINAMIC=no
        if [ "${DINAMIC}" = "no" ]; then
          ask_string "IP Address (192.168.0.1):" "" || return 1
          IPADDRESS=${ANSWER_STRING// /}
          ask_string "Gateway IP:" "" || return 1
          GATEWAY=${ANSWER_STRING// /}
          ask_string "DNS Server IP:" "" || return 1
          DNSSERVER=${ANSWER_STRING// /}
          ask_string "DNS Domain:" "" || return 1
          DNSDOMAIN=${ANSWER_STRING// /}
          DNSSEARCH=$DNSDOMAIN
        fi

        if [ "${DINAMIC}" = "no" ]; then
          sed -ri "s/^IP=.*/IP=static/" /etc/netctl/$file
          sed -ri "s/^Interface=.*/Interface=$IFACE/" /etc/netctl/$file
          sed -ri "s/^[#]*Address=.*/Address='${IPADDRESS}\/24\'/" /etc/netctl/$file
          sed -ri "s/^[#]*Gateway='.*/Gateway='${GATEWAY}'/" /etc/netctl/$file
          sed -ri "s/^[#]*DNS=.*/DNS=('${DNSSERVER}')/" /etc/netctl/$file

          sed -ri "s/^nameserver.*//" /etc/resolv.conf
          sed -ri '/^$/d' /etc/resolv.conf
          echo "nameserver ${DNSSERVER}" >>/etc/resolv.conf
          echo "nameserver ${DNSDOMAIN}" >>/etc/resolv.conf

        else
          sed -ri "s/^IP=.*/IP=dhcp/" /etc/netctl/$file
          sed -ri "s/^Interface=.*/Interface=$IFACE/" /etc/netctl/$file
          sed -ri "s/^Address=.*/Address=''/" /etc/netctl/$file
          sed -ri "s/^Gateway='.*/Gateway=''/" /etc/netctl/$file
          sed -ri "s/^[#]*DNS=.*/DNS=('8.8.8.8')/" /etc/netctl/$file
          sed -ri "s/^nameserver.*//" /etc/resolv.conf
          sed -ri '/^$/d' /etc/resolv.conf

        fi

        if [ "${WIRED}" = "no" ]; then
          sed -ri "s/^[#]*ESSID='.*/ESSID='${SSID}'/" /etc/netctl/$file
          sed -ri "s/^[#]*Security=.*/Security=${SECURI}/" /etc/netctl/$file
          sed -ri "s/^[#]*Key='.*/Key='${KEY}'/" /etc/netctl/$file
          sed -ri "s/^Connection=.*/Connection=wireless/" /etc/netctl/$file

        else
          sed -ri "s/^ESSID='.*/#ESSID=''/" /etc/netctl/$file
          sed -ri "s/^Security=.*/#Security=wpa/" /etc/netctl/$file
          sed -ri "s/^Key='.*/#Key=''/" /etc/netctl/$file
          sed -ri "s/^Connection=.*/Connection=ethernet/" /etc/netctl/$file
        fi

        ask_yesno "Bring up $IFACE interface?" || return

        ISUP=$(ifconfig | grep $IFACE)
        if [ "${ISUP}" = "" ]; then
          notify "Net Not Found"
        else
          if [ "${DINAMIC}" = "yes" -a "${WIRED}" = "no" ]; then
            ifconfig $IFACE down
            dhcpcd -x 2>>/dev/tty12
            sleep 2
          fi
          if [ "${WIRED}" = "no" ]; then
            netctl stop $file
            systemctl stop netctl@wifi.service
            netctl disable $file 2>>/dev/tty12
            dhcpcd -x 2>>/dev/tty12
            ifconfig $IFACE down
          fi
          netctl restart $file
          ifconfig $IFACE up
          systemctl restart sshd.service
          systemctl restart smb.service nmb.service
          netctl enable $file 2>>/dev/tty12
          ips=$(ifconfig $IFACE | grep -oiE '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -v 255 | grep -v 127.0.0.1)
          gate=$(ip route show | grep -oiE '([0-9]{1,3}\.){3}[0-9]{1,3}' -m 1)
          dnes=$(cat /etc/resolv.conf | grep -oiE '([0-9]{1,3}\.){3}[0-9]{1,3}')
          notify "Interface ${IFACE} is already running.\n\nIP ${ips}\nGW $gate\nDNS $dnes\n\n"

        fi
        NETWORK_SETUP=1
        return 0
        ;;
      "3") execute worker fix_network && default=3 ;;
      "4") return 0 ;;
      *) notify "Bad option $ANSWER_OPTION given" ;;
    esac
  done

}

worker_fix_network() {
  local default=no
  while [ 0 = 0 ]; do
    ask_option $default "Video Setup Menu" "Setup video" required \
      1 "Default Network" \
      2 "Enable Or Disable Wiimote" \
      3 "Time Out DHCP" \
      4 "Return to Main" || return

    case $ANSWER_OPTION in
      "1")
        netctl stop-all
        systemctl stop netctl@wifi.service netctl@wire.service
        systemctl disable netctl@wifi.service netctl@wire.service
        dhcpcd -x 2>>/dev/tty12
        netctl disable wifi
        netctl disable wired
        sudo rm /etc/netctl/{wifi,wired}
        sudo touch /etc/netctl/{wifi,wired}
        sudo chown arcade:users /etc/netctl/{wifi,wired}

        sudo echo "Description='A basic static ethernet connection'
Connection=ethernet
Interface=eth0
