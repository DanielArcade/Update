worker_select_locale() {
  if [ -f "/home/arcade/1" ]; then
    notify "You can only change the language on an installed system. Not in the LiveCD"
    return 1
  fi

  inform "Generating available locales list..."
  
  local locales_array=()
  for loc in $(grep -i "UTF-8" /etc/locale.gen | sed 's/^[ \t]*#//g' | awk '{print $1}'); do
    if [ -n "$loc" ]; then
      locales_array+=("$loc" "-")
    fi
  done

  if [ ${#locales_array[@]} -eq 0 ]; then
     notify "Error: Could not read /etc/locale.gen"
     return 1
  fi

  ask_option "no" "Select Locale" "Choose your system language" required "${locales_array[@]}" || return 1
  SELECTED_LOCALE=$ANSWER_OPTION

  log_info "Setting locale to $SELECTED_LOCALE"

  sed -i "s/^#\?[ \t]*${SELECTED_LOCALE}/${SELECTED_LOCALE}/" /etc/locale.gen
  
  inform "Generating locales (this may take a while)..."
  locale-gen >/dev/null 2>&1

  localectl set-locale LANG=$SELECTED_LOCALE
  
  echo "LANG=$SELECTED_LOCALE" > /etc/locale.conf
  
  notify "Language set to $SELECTED_LOCALE.\nPlease reboot the machine to apply to all menus."
  return 0
}

