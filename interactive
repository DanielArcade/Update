        esac
      else
        # STATE: Installed but Disabled
        ask_option $default "LPT Keycoder Arcade" "Select an action" required \
          1 "Install / Update Keycoder" \
          2 "Enable Keycoder Service" \
          3 "Return to Joystick Menu" || return
          
        case $ANSWER_OPTION in
