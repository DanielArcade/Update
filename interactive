worker_gamepad_pro_configure() {
  # 1. Alert the user about the screen change
  ask_yesno "This configuration tool requires a graphical desktop (X11).\nYou will be redirected to the LXDE desktop to configure it.\n\nWhen you close the desktop, you will return here.\nContinue?" || return 0
  
  inform "Launching Desktop Environment for Configuration..."
  
  # 2. Create a TEMPORARY xinitrc just for this graphical boot
  local tmp_xinit="/home/arcade/.xinitrc.gamepad"
  cat << 'EOF' > "$tmp_xinit"
xhost +
xset s off
xset -dpms
# Launch the GUI interface in the background and start LXDE
python3 /opt/gamepad2key/gui_gamepad.py &
exec startlxde
EOF

  # Set correct permissions for the arcade user
  chown arcade:arcade "$tmp_xinit"
  chmod +x "$tmp_xinit"
  
  # 3. Start X11 using the temporary file we just created.
  # When the user logs out from LXDE, X11 shuts down and the script continues here!
  su arcade -c "startx $tmp_xinit -- vt7" > /dev/null 2>&1
  
  # 4. Clean up the evidence after the user exits the desktop
  rm -f "$tmp_xinit"
  
  clear
  return 0
}

